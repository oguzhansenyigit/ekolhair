RewriteEngine On

# Block sensitive paths
RewriteRule ^(includes/|sql/|\.env) - [F,L]

# Pretty URLs
RewriteRule ^before-after/?$ before-after.php [L,QSA]
RewriteRule ^hizmetler/?$ hizmetler.php [L,QSA]
RewriteRule ^hakkimizda/?$ hakkimizda.php [L,QSA]
RewriteRule ^iletisim/?$ iletisim.php [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-z0-9\-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^ilce/([a-z0-9\-]+)/?$ ilce.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Existing files/dirs pass through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
